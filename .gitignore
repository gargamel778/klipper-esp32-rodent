# ── Secrets ───────────────────────────────────────────────────────────────────
# The pre-Klipper FluidNC factory image. Two reasons it must never be committed:
#   1. Its NVS partition (0x9000-0xE000) holds the board's provisioned Wi-Fi
#      credentials — Sta/SSID, Sta/Password, ap.passwd, and a 63-char PSK at 0xa8e0.
#   2. It is BigTreeTech's firmware, not ours, so it is not ours to redistribute.
# Keep the directory on disk; it is the only copy of this board's original flash.
rodent-backup/
devkit-backup/

# ── Local-only: third-party docs and working files, kept but never published ──
_local/

# ── Vendored upstream trees (clone them yourself; patches go upstream) ────────
fermino-esp32/
klipper/

# ── Virtualenvs and build noise ──────────────────────────────────────────────
klippy-venv/
esptool-venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
