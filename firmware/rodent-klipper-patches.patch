diff --git a/src/esp32/gpio/gpio_pwm.h b/src/esp32/gpio/gpio_pwm.h
index ad9300ee..79a526e4 100644
--- a/src/esp32/gpio/gpio_pwm.h
+++ b/src/esp32/gpio/gpio_pwm.h
@@ -1,5 +1,6 @@
 #pragma once
 
+#include "esp_idf_version.h"
 #include "hal/ledc_types.h"
 #include "hal/ledc_ll.h"
 
@@ -15,6 +16,16 @@ static inline void __attribute__((always_inline)) gpio_pwm_write(struct gpio_pwm
     // @todo some of this could be removed
     ledc_ll_set_duty_int_part(LEDC_LL_GET_HW(), LEDC_LOW_SPEED_MODE, gpio.ledc_channel, val);
     ledc_ll_set_sig_out_en(LEDC_LL_GET_HW(), LEDC_LOW_SPEED_MODE, gpio.ledc_channel, true);
+    // ledc_ll_set_duty_start()'s signature changed in ESP-IDF v5.5.2. Up to and
+    // including v5.5.1 the caller supplies duty_start as a 4th argument. From
+    // v5.5.2 the function takes three arguments: it always sets duty_start, and
+    // first busy-waits for any previous duty change to take effect — an
+    // ESP32-specific quirk Espressif moved out of callers and into the HAL.
+    // Passing `true` on the older signature reproduces the newer behaviour.
+#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 5, 2)
     ledc_ll_set_duty_start(LEDC_LL_GET_HW(), LEDC_LOW_SPEED_MODE, gpio.ledc_channel);
+#else
+    ledc_ll_set_duty_start(LEDC_LL_GET_HW(), LEDC_LOW_SPEED_MODE, gpio.ledc_channel, true);
+#endif
     ledc_ll_ls_channel_update(LEDC_LL_GET_HW(), LEDC_LOW_SPEED_MODE, gpio.ledc_channel);
 }
