diff --git a/klippy/chelper/pyhelper.c b/klippy/chelper/pyhelper.c
index 8d4e4ee8..fb885c33 100644
--- a/klippy/chelper/pyhelper.c
+++ b/klippy/chelper/pyhelper.c
@@ -10,7 +10,11 @@
 #include <stdio.h> // fprintf
 #include <string.h> // strerror
 #include <time.h> // struct timespec
+#ifdef __linux__
 #include <sys/prctl.h>  // prctl
+#else
+#include <pthread.h> // pthread_setname_np
+#endif
 #include "compiler.h" // __visible
 #include "pyhelper.h" // get_monotonic
 
@@ -98,5 +102,12 @@ dump_string(char *outbuf, int outbuf_size, char *inbuf, int inbuf_size)
 int __visible
 set_thread_name(char name[16])
 {
+#ifdef __linux__
     return prctl(PR_SET_NAME, name);
+#elif defined(__APPLE__)
+    // macOS can only name the calling thread, and takes no PR_SET_NAME
+    return pthread_setname_np(name);
+#else
+    return 0;
+#endif
 }
diff --git a/klippy/chelper/serialqueue.c b/klippy/chelper/serialqueue.c
index 3ab7216b..2efde203 100644
--- a/klippy/chelper/serialqueue.c
+++ b/klippy/chelper/serialqueue.c
@@ -12,7 +12,19 @@
 // clock times, prioritizes commands, and handles retransmissions.  A
 // background thread is launched to do this work and minimize latency.
 
+#ifdef __linux__
 #include <linux/can.h> // // struct can_frame
+#else
+// SocketCAN is Linux-only. Declare the wire layout so the CAN branches still
+// compile on macOS/BSD; serial_fd_type is never SQT_CAN on those platforms.
+#include <stdint.h> // uint32_t (needed here: this precedes the include below)
+struct can_frame {
+    uint32_t can_id;
+    uint8_t can_dlc;
+    uint8_t __pad, __res0, __res1;
+    uint8_t data[8] __attribute__((aligned(8)));
+};
+#endif
 #include <math.h> // fabs
 #include <pthread.h> // pthread_mutex_lock
 #include <stddef.h> // offsetof
diff --git a/scripts/ctr/extract_sections b/scripts/ctr/extract_sections
index 086b761f..c97fec74 100755
--- a/scripts/ctr/extract_sections
+++ b/scripts/ctr/extract_sections
@@ -8,9 +8,12 @@ fi
 
 OBJCOPY_BIN="${1}"
 
-TMP_FILE="$(mktemp --suffix '.ctr')"
+# NB: `mktemp --suffix` is GNU coreutils only and is absent on BSD/macOS.
+# A temp directory with a fixed name inside is portable to both.
+TMP_DIR="$(mktemp -d)"
+TMP_FILE="${TMP_DIR}/section.ctr"
 cleanup() {
-	rm -f "${TMP_FILE}"
+	rm -rf "${TMP_DIR}"
 }
 trap cleanup EXIT
 
